{
  "name": "cutz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free, browser-based cut list optimizer for hobbyist woodworkers.",
  "license": "MIT",
  "homepage": "https://carloswaibl.github.io/Cutz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carloswaibl/Cutz.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "bench": "vitest run test/bench",
    "bench:update": "UPDATE_BENCH_BASELINE=true vitest run test/bench",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "svg-pathdata": "^9.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
